RewriteEngine On

RewriteCond %{HTTP_HOST} !=marcel.bollmann.me
RewriteRule (.*) http://marcel.bollmann.me/$1 [R=302,L]

RewriteCond %{REQUEST_URI} ^/simplenlg-ger\.html?$ [NC]
RewriteRule . /software/simplenlg.html [R=301,L]

RewriteCond %{REQUEST_URI} /index\.html?$ [NC]
RewriteRule ^(.*)index\.html?$ "/$1" [NC,R=301,NE]
