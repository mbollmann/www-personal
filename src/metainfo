--- paths
/**/*.page:
  blocks: {defaults: {pipeline: [erb,tags,kramdown,blocks]}}
  meta:
    author: Marcel Bollmann
    keywords: computational linguistics, nlp, historical linguistics, corpus linguistics, linguistics, natural language generation, personal website, academia, tools

fonts/*:
  handler: copy

pub/*.pdf:
  handler: copy

pub/*.txt:
  handler: copy

pub/*.zip:
  handler: copy

/**/*.scss:
  pipeline: [scss,yui_compressor]
  dest_path: <parent><basename>.css

